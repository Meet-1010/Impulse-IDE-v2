{
  "name": "arduino-ide-cursor",
  "version": "1.0.0",
  "description": "AI-assisted Arduino IDE with a built-in AVR simulator, hardware tests and a pin-aware editor",
  "main": "src/main/main.js",
  "scripts": {
    "prestart": "vite build",
    "start": "electron .",
    "dev": "concurrently --kill-others \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:all": "npm run build:renderer && electron-builder --win --mac --linux",
    "test": "jest",
    "lint": "eslint src/ scripts/ test/ --ext .js,.mjs",
    "lint:fix": "eslint src/ scripts/ test/ --ext .js,.mjs --fix",
    "audit": "npm audit --omit=dev",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "arduino",
    "iot",
    "ide",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "concurrently": "^9.2.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^30.5.2",
    "vite": "^6.4.1",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@serialport/parser-readline": "^12.0.0",
    "@wokwi/elements": "^1.9.2",
    "avr8js": "^0.21.0",
    "codemirror": "^5.65.18",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "openai": "^4.20.0",
    "serialport": "^12.0.0",
    "zod": "^3.23.8"
  },
  "build": {
    "appId": "com.impulseide.app",
    "productName": "Impulse IDE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "dist-renderer/**/*",
      "assets/**/*",
      "!**/*.map"
    ],
    "publish": {
      "provider": "github",
      "owner": "nate1029",
      "repo": "Impulse"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "certificateSubjectName": "${env.WIN_CSC_SUBJECT_NAME}"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "${env.MAC_CSC_NAME}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "maintainer": "Impulse IDE <hello@impulseide.dev>",
      "desktop": {
        "entry": {
          "StartupWMClass": "impulse-ide"
        }
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "npmRebuild": false
  },
  "allowScripts": {
    "@serialport/bindings-cpp@12.0.1": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "electron@44.5.1": true,
    "electron-winstaller@5.4.0": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
