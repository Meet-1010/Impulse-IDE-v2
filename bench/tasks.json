{
 "bench": "EmbedBench",
 "version": 0,
 "note": "Each task: the board, the request as a user would type it, the circuit (parts wired to board pins), the checks the simulator runs, and a reference sketch in bench/reference/<id>.ino that passes them. See bench/README.md.",
 "tasks": [
  {
   "id": "uno-blink-onboard",
   "board": "uno",
   "category": "gpio",
   "ask": "Blink the onboard LED: 500 ms on, 500 ms off.",
   "expect": [
    "pin 13 frequency 1Hz ±5%"
   ],
   "seconds": 3
  },
  {
   "id": "uno-blink-pin8",
   "board": "uno",
   "category": "gpio",
   "ask": "I wired an LED with a 220 ohm resistor to pin 8. Blink it twice per second with equal on and off times.",
   "expect": [
    "pin 8 frequency 2Hz ±5%"
   ],
   "seconds": 3,
   "circuit": {
    "parts": [
     {
      "type": "wokwi-led",
      "id": "led1",
      "attrs": {
       "color": "red"
      }
     },
     {
      "type": "wokwi-resistor",
      "id": "r1",
      "attrs": {
       "value": "220"
      }
     }
    ],
    "connections": [
     [
      "uno:8",
      "r1:1"
     ],
     [
      "r1:2",
      "led1:A"
     ],
     [
      "led1:C",
      "uno:GND.1"
     ]
    ]
   }
  },
  {
   "id": "uno-two-rates",
