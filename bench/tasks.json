       "color": "green"
      }
     },
     {
      "type": "wokwi-resistor",
      "id": "r2",
      "attrs": {
       "value": "220"
      }
     }
    ],
    "connections": [
     [
      "uno:9",
      "r1:1"
     ],
     [
      "r1:2",
      "led1:A"
     ],
     [
      "led1:C",
