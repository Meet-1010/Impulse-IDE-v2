{
  "name": "impulse-cloud",
  "private": true,
  "version": "0.1.0",
  "description": "Impulse Cloud: accounts, credits, the AI gateway and the admin console for Impulse IDE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch scripts/serve.js",
    "start": "node --env-file-if-exists=.env scripts/serve.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --test --test-concurrency=1 --test-timeout=30000 test/*.test.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "better-auth": "1.7.7",
    "hono": "4.13.12",
    "pg": "8.23.1"
  }
}
